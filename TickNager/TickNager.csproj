<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="BBDD\TickNager.db" />
    <None Remove="Imagenes\Iconos\perfil.png" />
    <None Remove="Imagenes\Iconos\perfil_administrador.png" />
    <None Remove="Imagenes\Iconos\perfil_administradora.png" />
    <None Remove="Imagenes\Iconos\perfil_tecnica.png" />
    <None Remove="Imagenes\Iconos\perfil_tecnico.png" />
    <None Remove="Imagenes\Iconos\perfil_usuaria.png" />
    <None Remove="Imagenes\Iconos\perfil_usuario.png" />
    <None Remove="Imagenes\Logotipo\Logotipo_TickNager.png" />
    <None Remove="SQL\script.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="BBDD\TickNager.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SQL\script.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Imagenes\Logotipo\Logotipo_TickNager.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Imagenes\Iconos\perfil_administrador.png" />
    <Resource Include="Imagenes\Iconos\perfil_administradora.png" />
    <Resource Include="Imagenes\Iconos\perfil_tecnica.png" />
    <Resource Include="Imagenes\Iconos\perfil_tecnico.png" />
    <Resource Include="Imagenes\Iconos\perfil_usuaria.png" />
    <Resource Include="Imagenes\Iconos\perfil_usuario.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="UserControls\IncidenciaCreada.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>
