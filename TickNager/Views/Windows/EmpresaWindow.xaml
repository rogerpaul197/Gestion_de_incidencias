<Window x:Class="TickNager.Views.Windows.EmpresaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        mc:Ignorable="d"
        Title="EmpresaWindow" Height="780" Width="820">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#0C0D21">
            <Image Source="/Imagenes/Iconos/Empresa.png"/>
        </Grid>

        <Grid Grid.Column="1" Background="#171A45">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="¿A qué empresa Trabajas?" Margin="20 20 0 0" FontSize="30" Foreground="White"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Text="Nombre de la empresa:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="NIF/CIF:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock Text="Ciudad:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="4">
                <TextBlock Text="Código postal:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="5">
                <TextBlock Text="Dirección:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="6">
                <TextBlock Text="Número de contacto:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="7">
                <TextBlock Text="Correo electrónico:" VerticalAlignment="Top" Margin="44 0 0 0" FontSize="20" Foreground="White"/>
                <TextBox Height="30" Width="320" Margin="0 20 0 0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Button Height="40" Width="100" Content="Cancelar" FontSize="15"/>
                </Grid>

                <Grid Grid.Column="1">
                    <Button Height="40" Width="100" Content="Siguiente" FontSize="15"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
