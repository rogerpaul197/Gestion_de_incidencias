<Window x:Class="TickNager.Views.Windows.EmpresaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        mc:Ignorable="d"
        Title="EmpresaWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="¿A qué empresa Trabajas?" Margin="0 20 0 0" FontSize="30"/>
                <TextBlock Text="Nombre:" Margin="10 80 0 0" FontSize="20"/>
                <TextBox Height="30" Width="320" Margin="0 60 55 0"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Text="Departamento:" VerticalAlignment="Top" Margin="10 30 0 0" FontSize="20"/>
                <TextBox Height="30" Width="320" Margin="0 0 55 0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
