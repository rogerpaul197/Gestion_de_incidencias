<Window x:Class="TickNager.Views.Windows.LoginRegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        mc:Ignorable="d"
        Title="LoginRegistroWindow" Height="250" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="Ticknager" TextAlignment="Center" FontSize="30"/>
        </Grid>

        <Grid Grid.Row="1">
            <Button Height="30" Width="100" HorizontalAlignment="Left" Margin="50 0 0 0" Content="Iniciar sesión" Click="btnIniciarSesion_Click"/>
            <Button Height="30" Width="100" HorizontalAlignment="Right" Margin="0 0 50 0" Content="Registrarme" Click="btnRegistro_Click"/>
        </Grid>
    </Grid>
</Window>
