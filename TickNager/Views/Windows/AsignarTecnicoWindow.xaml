<Window x:Class="TickNager.Views.Windows.AsignarTecnicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        mc:Ignorable="d"
        Title="AsignarTecnicoWindow" Height="450" Width="800">
    <Grid Background="White" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Asignar técnico"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1D2B53"/>

            <TextBlock Text="Selecciona el técnico que resolverá esta incidencia"
                       Margin="0 8 0 20"
                       FontSize="15"
                       Foreground="#6B7280"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tecnicos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="14 6"
                                    Cursor="Hand">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 VerticalAlignment="Center"
                                                 GroupName="Tecnicos"
                                                 Checked="RadioTecnico_Checked"/>

                                    <Image Grid.Column="1"
                                           Source="{Binding ImagenPerfil}"
                                           Width="48"
                                           Height="48"
                                           VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Margin="12 0 0 0">
                                        <TextBlock Text="{Binding NombreCompleto}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>

                                        <TextBlock Text="{Binding Departamento}"
                                                   Margin="0 4 0 0"
                                                   FontSize="13"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="{Binding CorreoUsuario}"
                                                   Margin="0 3 0 0"
                                                   FontSize="13"
                                                   Foreground="#2563EB"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0 22 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#E5E7EB"
                    Height="44"
                    Width="135"
                    CornerRadius="10"
                    HorizontalAlignment="Left">
                <Button Content="Cancelar"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#374151"
                        FontWeight="SemiBold"
                        Click="btnCancelar_Click"/>
            </Border>

            <Border Grid.Column="1"
                    Background="#2F6BFF"
                    Height="44"
                    Width="135"
                    CornerRadius="10"
                    HorizontalAlignment="Right">
                <Button Content="Asignar"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="btnAsignar_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
