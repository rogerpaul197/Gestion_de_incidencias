<Window x:Class="TickNager.Views.Windows.InformacionWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        xmlns:vm="clr-namespace:TickNager.ViewModels"
        mc:Ignorable="d"
        Title="Informacion" Height="410" Width="430">
    <Window.DataContext>
        <vm:InformacionWindow2ViewModel/>
    </Window.DataContext>
    <Grid Background="#151f2d">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Image Source="/Imagenes/Iconos/perfil_usuario.png" Margin="0 10 0 0"/>
            </Grid>
            <Grid Grid.Column="1">
                <Image Source="/Imagenes/Iconos/perfil_tecnico.png" Margin="0 10 0 0"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="{Binding Informacion}" FontSize="15" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" Margin="15 0 15 0"/>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="#0D1E36" Height="40" Width="100" CornerRadius="10" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="White">
                <Button Height="40" Width="100" Content="Entendido" Background="Transparent" BorderThickness="0" Foreground="White" Click="btnEntendido_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
