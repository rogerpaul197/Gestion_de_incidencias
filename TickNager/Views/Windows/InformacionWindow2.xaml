<Window x:Class="TickNager.Views.Windows.InformacionWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        mc:Ignorable="d"
        Title="InformacionWindow2" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Image Source="/Imagenes/Iconos/perfil_usuario.png"/>
            </Grid>
            <Grid Grid.Column="1">
                <Image Source="/Imagenes/Iconos/perfil_tecnico.png"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="{Binding informacion}"/>
        </Grid>
    </Grid>
</Window>
