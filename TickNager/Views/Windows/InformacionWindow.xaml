<Window x:Class="TickNager.Views.Windows.InformacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickNager.Views.Windows"
        xmlns:vm="clr-namespace:TickNager.ViewModels"
        mc:Ignorable="d"
        Title="Informacion" Height="370" Width="400">

    <Window.DataContext>
        <vm:InformacionWindowViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource ColorAzulOscuro}">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="135"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image Source="/Imagenes/Iconos/perfil_administrador.png" Height="110" Margin="0 10 0 0"/>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="{Binding Informacion}" FontSize="15" FontFamily="{StaticResource FuentePrincipal}" TextWrapping="Wrap" TextAlignment="Center" Margin="0 20 0 0" Foreground="White"/>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource ColorBotonAzulOscuro}" Height="40" Width="100" CornerRadius="10" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="White">
                <Button Height="40" Width="100" FontFamily="{StaticResource FuentePrincipal}" Content="Siguiente" Background="Transparent" BorderThickness="0" Foreground="White" HorizontalAlignment="Center" Click="btnSiguiente_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
