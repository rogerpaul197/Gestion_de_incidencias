<UserControl x:Class="TickNager.UserControls.GrupoTrabajoCreado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0 0 0 1"
            Padding="18 14">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Border Width="44"
                        Height="44"
                        Background="#EEF2FF"
                        CornerRadius="22"
                        Margin="0 0 14 0">

                    <iconPacks:PackIconMaterial Kind="AccountGroup"
                                                Width="22"
                                                Height="22"
                                                Foreground="Black"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreDepartamento}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Grupo de trabajo"
                               Margin="0 4 0 0"
                               FontSize="13"
                               Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#DCFCE7"
                    Width="115"
                    Height="30"
                    CornerRadius="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <TextBlock Text="{Binding TextoMiembros}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#15803D"/>
            </Border>

            <Grid Grid.Column="2">
                <Border Width="42"
                        Height="38"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <ToggleButton x:Name="btnAcciones"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand">
                        <iconPacks:PackIconMaterial Kind="DotsVertical"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="#6B7280"/>
                    </ToggleButton>
                </Border>

                <Popup IsOpen="{Binding IsChecked, ElementName=btnAcciones}"
                       PlacementTarget="{Binding ElementName=btnAcciones}"
                       Placement="Bottom"
                       StaysOpen="False">

                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">

                        <StackPanel Width="150">
                            <Button Content="Renombrar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    Padding="10 7"
                                    Click="btnRenombrar_Click"/>

                            <Button Content="Eliminar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    Padding="10 7"
                                    Foreground="#B91C1C"
                                    Click="btnEliminar_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PuedeGestionar}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </Grid>
    </Border>
</UserControl>
