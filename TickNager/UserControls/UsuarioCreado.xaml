<UserControl x:Class="TickNager.UserControls.UsuarioCreado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800" BorderBrush="Transparent" Background="Transparent">
    <Border Background="#171A45" Width="500" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="10" Margin="0 0 0 20">
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
                <Image Source="{Binding ImagenPerfil}" Height="120" Width="120"/>
            </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <TextBlock x:Name="tbNombreUsuario" Text="{Binding NombreCompleto}" Foreground="White" FontSize="24"/>
            </Grid>
            
            <Grid Grid.Row="1">
                <TextBlock Text="{Binding RolUsuario}" Foreground="White" FontSize="20"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="Ver perfil" Foreground="#7B68EE" FontSize="18" TextDecorations="Underline" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Grid>
</Border>
</UserControl>
