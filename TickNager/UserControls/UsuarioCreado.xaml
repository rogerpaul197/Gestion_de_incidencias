<UserControl x:Class="TickNager.UserControls.UsuarioCreado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="830" BorderBrush="Transparent" Background="Transparent">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0 0 0 1" Padding="18 14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="{Binding ImagenPerfil}" Width="48" Height="48" Margin="0 0 12 0"/>

                <StackPanel>
                    <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                    <TextBlock Text="Ver perfil" Margin="0 4 0 0" FontSize="13" Foreground="#2563EB" TextDecorations="Underline"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding RolUsuario}" VerticalAlignment="Center" FontSize="14" Foreground="#374151"/>
            <TextBlock Grid.Column="2" Text="{Binding CorreoUsuario}" VerticalAlignment="Center" FontSize="14" Foreground="#6B7280"/>
            <TextBlock Grid.Column="3" Text="{Binding Departamento}" VerticalAlignment="Center" FontSize="14" Foreground="#6B7280"/>

            <Grid Grid.Column="4">
                <Border Width="42" Height="38" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <Button Content="⋮" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#6B7280"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
