<UserControl x:Class="TickNager.UserControls.UsuarioCreado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="830" BorderBrush="Transparent" Background="Transparent">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0 0 0 1" Padding="18 14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="{Binding ImagenPerfil}" Width="48" Height="48" Margin="0 0 12 0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding RolUsuario}" VerticalAlignment="Center" FontSize="14" Foreground="#374151"/>
            <TextBlock Grid.Column="2" Text="{Binding CorreoUsuario}" VerticalAlignment="Center" FontSize="14" Foreground="#6B7280"/>
            <TextBlock Grid.Column="3" Text="{Binding Departamento}" VerticalAlignment="Center" FontSize="14" Foreground="#6B7280"/>

            <Grid Grid.Column="4">
                <Border Width="42"
            Height="38"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                    <ToggleButton x:Name="btnAcciones"
                      Content="⋮"
                      Background="Transparent"
                      BorderThickness="0"
                      FontSize="18"
                      Foreground="#6B7280"
                      Cursor="Hand"/>
                </Border>

                <Popup IsOpen="{Binding IsChecked, ElementName=btnAcciones}"
           PlacementTarget="{Binding ElementName=btnAcciones}"
           Placement="Bottom"
           StaysOpen="False">
                    <Border Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4">
                        <StackPanel Width="170">
                            <Button Content="Ver perfil"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10 7"
                        Click="menuVerPerfil_Click"/>

                            <Button Content="Cambiar rol"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10 7"
                        Click="menuCambiarRol_Click"/>

                            <Button Content="Eliminar usuario"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10 7"
                        Foreground="#B91C1C"
                        Click="menuEliminarUsuario_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Border>
</UserControl>
