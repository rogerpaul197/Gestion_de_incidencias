<UserControl x:Class="TickNager.UserControls.VistaIncidenciasTecnico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Mis incidencias asignadas" FontSize="34" FontWeight="Bold" Foreground="#1D2B53"/>
                <TextBlock Text="Gestiona las incidencias que tienes asignadas" Margin="0 8 0 0" FontSize="18" Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="14 14 0 0" BorderBrush="#E5E7EB" BorderThickness="0 0 0 1">
                        <Grid Margin="18 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Incidencia" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Grid.Column="1" Text="Categoría" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="19 0 0 0"/>
                            <TextBlock Grid.Column="2" Text="Prioridad" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="40 0 0 0"/>
                            <TextBlock Grid.Column="3" Text="Estado" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="70 0 0 0"/>
                            <TextBlock Grid.Column="4" Text="Fecha" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="60 0 0 0"/>
                            <TextBlock Grid.Column="5" Text="Acciones" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Incidencias}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:IncidenciaTecnicoCreada/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
