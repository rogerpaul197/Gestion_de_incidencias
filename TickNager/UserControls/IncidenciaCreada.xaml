<UserControl x:Class="TickNager.UserControls.IncidenciaCreada"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0 0 0 1"
            Padding="18 14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!--Incidencia-->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Titulo}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>
                <TextBlock Text="{Binding Descripcion}"
                           Margin="0 4 0 0"
                           FontSize="13"
                           Foreground="#6B7280"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!--Categoría-->
            <TextBlock Grid.Column="1"
                       Text="{Binding Categoria}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#374151"/>

            <!--Prioridad-->
            <Border Grid.Column="2"
                    Width="90"
                    Height="30"
                    Background="#FEF3C7"
                    CornerRadius="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Prioridad}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B45309"/>
            </Border>

            <!--Estado-->
            <Border Grid.Column="3"
                    Width="110"
                    Height="30"
                    Background="#DCFCE7"
                    CornerRadius="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#16A34A"
                             Margin="0 0 6 0"/>
                    <TextBlock Text="{Binding Estado}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#15803D"/>
                </StackPanel>
            </Border>

            <!--Fecha-->
            <TextBlock Grid.Column="4"
                       Text="{Binding FechaRegistro}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#6B7280"/>

            <!--Acciones-->
            <Grid Grid.Column="5">
                <Border Width="42"
                        Height="38"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Button Content="⋮"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Foreground="#6B7280"
                            Cursor="Hand"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
