<UserControl x:Class="TickNager.UserControls.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#0C0D21" Margin="20">
        <StackPanel Orientation="Vertical">
            <Border Background="Purple" Height="50" Width="150" CornerRadius="10" Margin="0,0,0,15">
                <Button Height="50" Width="150" Content="Crear Categoría" Background="Transparent" BorderThickness="0" Foreground="White"/>
            </Border>
            <Border Background="Purple" Height="50" Width="150" CornerRadius="10" Margin="0,0,0,15">
                <Button Height="50" Width="150" Content="Ver Categorías" Background="Transparent" BorderThickness="0" Foreground="White"/>
            </Border>
            <Border Background="Purple" Height="50" Width="150" CornerRadius="10">
                <Button Height="50" Width="150" Content="Eliminar Categoría" Background="Transparent" BorderThickness="0" Foreground="White"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
