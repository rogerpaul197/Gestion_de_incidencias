<UserControl x:Class="TickNager.UserControls.FormularioCrearCategoria"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#181A42" Height="410" Margin="140 0 150 0" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Nueva categoría" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Foreground="White" FontFamily="Dubai Light" Margin="50 0 0 0"/>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Text="Título" FontSize="15" Foreground="White" FontFamily="Dubai Light" Margin="46 0 0 0"/>
                <TextBox Text="{Binding Titulo}" Height="30" Width="400" Margin="0 20 0 0" Padding="6,4"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="Descripción" FontSize="15" Foreground="White" FontFamily="Dubai Light" Margin="46 10 0 0"/>
                <TextBox Text="{Binding Descripcion}" Height="50" Width="400" Margin="0 20 0 0" Padding="6,4"/>
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock Text="Imagen Representativa" FontSize="15" Foreground="White" FontFamily="Dubai Light" Margin="46 10 0 0"/>
                <Border Background="White" Height="40" Width="120" HorizontalAlignment="Left" Margin="250 5 0 0" CornerRadius="5">
                    <Image Source="{Binding ImagenCategoria}" Stretch="Uniform"/>
                </Border>
                <Border Background="#7B68EE" CornerRadius="10" Height="30" Width="100" HorizontalAlignment="Left" Margin="390 10 0 0">
                    <Button Background="Transparent" Height="30" Width="100" HorizontalAlignment="Left" Content="Seleccionar" BorderThickness="0" Foreground="White" Click="btnSeleccionarImagen_Click"/>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Border Background="#7B68EE" CornerRadius="10" Height="30" Width="100" HorizontalAlignment="Left" Margin="320 0 0 0">
                    <Button Background="Transparent" Height="30" Width="100" HorizontalAlignment="Left" Content="Guardar" BorderThickness="0" Foreground="White" Click="btnGuardar_Click"/>
                </Border>
                <Border CornerRadius="10" Background="#7B68EE" Height="30" Width="100" HorizontalAlignment="Left" Margin="80 0 0 0">
                    <Button Background="Transparent" Height="30" Width="100" HorizontalAlignment="Left" Content="Cancelar" BorderThickness="0" Foreground="White" Click="btnCancelar_Click"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
