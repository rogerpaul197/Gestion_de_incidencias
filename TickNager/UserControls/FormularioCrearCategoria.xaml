<UserControl x:Class="TickNager.UserControls.FormularioCrearCategoria"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <Border Background="#181A42" CornerRadius="10" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <iconPacks:PackIconMaterial Kind="Tag" Height="50" Width="50" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock Text="Nueva categoría" Foreground="White" FontSize="35" VerticalAlignment="Center" Margin="10 0 0 60"/>
                    <TextBlock Text="Completa la información y selecciona una imagen." Foreground="White" FontSize="15" Margin="10 15 0 0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Título" Foreground="White" Margin="25 10 0 0" FontSize="15"/>
                        <Border Background="White" CornerRadius="10" Height="50" Width="320" Margin="20 15 0 0">
                            <TextBox Text="{Binding Titulo}" Height="50" Width="350" Padding="2 5 0 0" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Text="Descripción" Foreground="White" Margin="25 10 0 0" FontSize="15"/>
                        <Border Background="White" CornerRadius="10" Height="100" Width="320" Margin="20 45 0 0">
                            <TextBox Text="{Binding Descripcion}" Height="100" Width="350" Padding="2 5 0 0" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Imagen representativa" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="15"/>
                        <Image Source="{Binding ImagenCategoria}" Height="180" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 25 0 0"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border Background="#7B68EE" Height="35" Width="160" CornerRadius="10">
                            <Button Content="Seleccionar imagen" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Border Background="#7B68EE" Height="40" Width="110" CornerRadius="10" HorizontalAlignment="Right" Margin="0 20 230 20">
                    <Button Content="Cancelar" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="btnCancelar_Click"/>
                </Border>
                <Border Background="#7B68EE" Height="40" Width="110" CornerRadius="10" HorizontalAlignment="Right" Margin="0 20 60 20">
                    <Button Content="Guardar" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Click="btnGuardar_Click"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
