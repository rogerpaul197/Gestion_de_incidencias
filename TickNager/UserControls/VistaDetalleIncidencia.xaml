<UserControl x:Class="TickNager.UserControls.VistaDetalleIncidencia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Detalle de incidencia"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1D2B53"/>

                <TextBlock Text="Consulta toda la información registrada sobre la incidencia"
                           Margin="0 8 0 0"
                           FontSize="18"
                           Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="30">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Título"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"/>

                        <TextBlock Text="{Binding Titulo}"
                                   Margin="0 6 0 0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Descripción"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"/>

                        <TextBlock Text="{Binding Descripcion}"
                                   Margin="0 6 0 0"
                                   FontSize="16"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Categoría"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding Categoria}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Prioridad"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding Prioridad}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Estado"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding Estado}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Usuario reportero"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding UsuarioReportero}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Técnico asignado"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding TecnicoAsignado}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fechas"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="{Binding FechaCreacion}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>

                            <TextBlock Text="{Binding FechaCierre}"
                                       Margin="0 4 0 0"
                                       FontSize="16"
                                       Foreground="#1F2937"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="8"
                            Background="#2F6BFF"
                            Height="45"
                            Width="130"
                            CornerRadius="10"
                            HorizontalAlignment="Right">

                        <Button Content="Volver"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="btnVolver_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
