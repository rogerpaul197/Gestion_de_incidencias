<UserControl x:Class="TickNager.UserControls.FormularioCambiarRolUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Cambiar rol de usuario"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1D2B53"/>

                <TextBlock Text="Selecciona el nuevo rol para el usuario"
                           Margin="0 8 0 0"
                           FontSize="18"
                           Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 25">
                        <TextBlock Text="Usuario"
                                   FontSize="14"
                                   Foreground="#374151"/>

                        <TextBlock Text="{Binding NombreCompleto}"
                                   Margin="0 8 0 0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                        <TextBlock Text="{Binding Correo}"
                                   Margin="0 4 0 0"
                                   FontSize="14"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0 0 0 30">
                        <TextBlock Text="Nuevo rol"
                                   FontSize="14"
                                   Foreground="#374151"
                                   Margin="0 0 0 8"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="45"
                                Margin="0 28 0 0">

                            <ComboBox ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding RolSeleccionado}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="14"
                                      Padding="8 0 8 0"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border Background="#E5E7EB"
                                Height="45"
                                Width="140"
                                CornerRadius="10"
                                HorizontalAlignment="Left">

                            <Button Content="Cancelar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#374151"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="btnCancelar_Click"/>
                        </Border>

                        <Border Background="#2F6BFF"
                                Height="45"
                                Width="140"
                                CornerRadius="10"
                                HorizontalAlignment="Right">

                            <Button Content="Guardar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Click="btnGuardar_Click"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
