<UserControl x:Class="TickNager.UserControls.FormularioCrearGrupoTrabajo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="35 30 35 20">
            <TextBlock Text="Nuevo grupo de trabajo"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#1D2B53"/>

            <TextBlock Text="Crea un grupo y selecciona sus miembros"
                       Margin="0 8 0 0"
                       FontSize="18"
                       Foreground="#6B7280"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Margin="35 0 35 30"
                Padding="28">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nombre del grupo"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>

                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="45"
                        Margin="0 8 0 22">

                    <TextBox Text="{Binding NombreGrupo}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12 10 12 0"
                             FontSize="14"/>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Usuarios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB"
                                            BorderThickness="0 0 0 1"
                                            Padding="14">

                                        <CheckBox IsChecked="{Binding Seleccionado}">
                                            <StackPanel Margin="10 0 0 0">
                                                <TextBlock Text="{Binding NombreCompleto}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"/>

                                                <TextBlock Text="{Binding CorreoUsuario}"
                                                           Margin="0 3 0 0"
                                                           FontSize="13"
                                                           Foreground="#6B7280"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Margin="0 22 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#E5E7EB"
                            Height="45"
                            Width="130"
                            CornerRadius="10"
                            HorizontalAlignment="Left">

                        <Button Content="Cancelar"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#374151"
                                FontWeight="SemiBold"
                                Click="btnCancelar_Click"/>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#2F6BFF"
                            Height="45"
                            Width="130"
                            CornerRadius="10"
                            HorizontalAlignment="Right">

                        <Button Content="Guardar"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="btnGuardar_Click"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
