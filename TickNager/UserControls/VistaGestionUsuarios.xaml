<UserControl x:Class="TickNager.UserControls.VistaGestionUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Gestión de usuarios" FontSize="34" FontWeight="Bold" Foreground="#1D2B53"/>
                <TextBlock Text="Administra los usuarios registrados en el sistema" Margin="0 8 0 0" FontSize="18" Foreground="#6B7280"/>
            </StackPanel>

            <Border Grid.Column="1" Width="190" Height="52" Background="#2F6BFF" CornerRadius="10">
                <Button Content="+  Nuevo usuario" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" FontWeight="SemiBold" Click="btnNuevoUsuario_Click"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="14 14 0 0" BorderBrush="#E5E7EB" BorderThickness="0 0 0 1">
                        <Grid Margin="18 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Usuario" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Grid.Column="1" Text="Rol" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Grid.Column="2" Text="Correo" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Grid.Column="3" Text="Departamento" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Grid.Column="4" Text="Acciones" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Usuarios}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:UsuarioCreado/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
