<UserControl x:Class="TickNager.UserControls.VistaGestionUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock Text="Gestión de usuarios:" FontWeight="Bold" FontSize="25" VerticalAlignment="Center" Margin="15 0 0 0"/>
            </Grid>

            <Grid Grid.Column="1">
                <Border Background="Black" Height="40" Width="120" CornerRadius="10" HorizontalAlignment="Right" Margin="0 0 20 0">
                    <Button Height="40" Width="120" Content="+ Nuevo usuario" Background="Transparent" BorderThickness="0" Foreground="White" Click="btnNuevoUsuario_Click"/>
                </Border>
            </Grid>
        </Grid>

        <!--Contenido-->
        <Border Grid.Row="1" Margin="20" Background="White" CornerRadius="10" BorderBrush="Gray" BorderThickness="0.7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--Cabecera-->
                <Border Grid.Row="0" Background="White" CornerRadius="10 10 0 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock Text="Usuarios:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="15 0 0 0"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock Text="Acciones:" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0 0 15 0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!--Lista-->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="White" Margin="20 0 20 20">
                        <ItemsControl ItemsSource="{Binding Usuarios}" Margin="0 10 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:UsuarioCreado />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
