<UserControl x:Class="TickNager.UserControls.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Columna derecha-->
        <Grid Grid.Column="0" Background="#0C0D21">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="210"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--Gráfico de barras-->
                <Grid Grid.Column="0">
                    <Border CornerRadius="15"
                   Background="#2A2A40"
                   Padding="20"
                   Margin="10">

                        <StackPanel>
                            <TextBlock Text="Incidencias:"
                               Foreground="White"
                               FontSize="16"
                               Opacity="0.7"/>

                            <!--Aquí debe ir el código del gráfico-->
                            <lvc:CartesianChart Name="MyChart" Height="100" Width="200"/>
                            <TextBlock/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--Gráfico circular-->
                <Grid Grid.Column="1">
                    <Border CornerRadius="15"
                   Background="#2A2A40"
                   Padding="20"
                   Margin="10">

                        <StackPanel>
                            <TextBlock Text="Estados de Incidencias:"
                               Foreground="White"
                               FontSize="16"
                               Opacity="0.7"/>

                            <lvc:PieChart Name="Circulo" Height="100" Width="300"/>
                            <TextBlock/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!--Gráfico Líneas-->
            <Grid Grid.Row="1">
                <Border CornerRadius="15"
            Background="#2A2A40"
            Padding="10"
            Margin="11"
            Height="180">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Prioridad de incidencias"
                           Foreground="White"
                           FontSize="16"
                           Opacity="0.7"/>

                        <lvc:CartesianChart Grid.Row="1" Name="Lineas" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
