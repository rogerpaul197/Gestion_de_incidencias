<UserControl x:Class="TickNager.UserControls.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="1050" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="34" FontWeight="Bold" Foreground="#1D2B53"/>
                <TextBlock Text="Resumen general del sistema y estado de las incidencias" Margin="0 8 0 0" FontSize="18" Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tarjetas resumen -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Incidencias totales" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalIncidencias}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Pendientes" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding IncidenciasPendientes}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="En proceso" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding IncidenciasEnProceso}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Usuarios" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalUsuarios}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Gráficos arriba -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Incidencias por prioridad" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Distribución entre baja, media y alta" Margin="0 6 0 0" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesPrioridades}" Margin="0 20 0 0" Height="260">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Prioridad" Labels="{Binding LabelsPrioridad}"/>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Cantidad" ShowLabels="False"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Estado de incidencias" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Resumen visual por estado actual" Margin="0 6 0 0" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>

                        <lvc:PieChart Grid.Row="1" Series="{Binding SeriesEstados}" Margin="0 20 0 0" Height="260"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Gráfico inferior -->
            <Grid Grid.Row="4">
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Tendencia de incidencias" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Evolución general de incidencias registradas" Margin="0 6 0 0" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesTendencia}" Margin="0 20 0 0" Height="300">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Fecha" Labels="{Binding LabelsTendencia}"/>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Cantidad" ShowLabels="False"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
