<UserControl x:Class="TickNager.UserControls.VistaEditarPerfil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="800">
    
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Editar perfil"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1D2B53"/>

                <TextBlock Text="Modifica tus datos personales"
                           Margin="0 8 0 0"
                           FontSize="18"
                           Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 18">
                        <TextBlock Text="Nombre"
                                   FontSize="14"
                                   Foreground="#374151"
                                   Margin="0 0 0 8"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="45">
                            <TextBox Text="{Binding Nombre}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12 10 12 0"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0 0 0 18">
                        <TextBlock Text="Apellido"
                                   FontSize="14"
                                   Foreground="#374151"
                                   Margin="0 0 0 8"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="45">
                            <TextBox Text="{Binding Apellido}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12 10 12 0"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0 0 0 18">
                        <TextBlock Text="Correo"
                                   FontSize="14"
                                   Foreground="#374151"
                                   Margin="0 0 0 8"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="45">
                            <TextBox Text="{Binding Correo}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12 10 12 0"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0 0 0 25">
                        <TextBlock Text="Departamento"
                                   FontSize="14"
                                   Foreground="#374151"
                                   Margin="0 0 0 8"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="45">
                            <TextBox Text="{Binding Departamento}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12 10 12 0"
                                     FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Border Background="#E5E7EB"
                                Height="45"
                                Width="120"
                                CornerRadius="10"
                                Margin="0 0 12 0">
                            <Button Content="Cancelar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#374151"
                                    FontWeight="SemiBold"
                                    Click="btnCancelar_Click"/>
                        </Border>

                        <Border Background="#2F6BFF"
                                Height="45"
                                Width="120"
                                CornerRadius="10">
                            <Button Content="Guardar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="btnGuardar_Click"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
