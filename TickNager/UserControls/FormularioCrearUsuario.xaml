<UserControl x:Class="TickNager.UserControls.FormularioCrearUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TickNager.UserControls"
             xmlns:vm="clr-namespace:TickNager.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="890" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Nuevo usuario" FontSize="34" FontWeight="Bold" Foreground="#1D2B53"/>
                <TextBlock Text="Completa la información para registrar un nuevo usuario" Margin="0 8 0 0" FontSize="18" Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14">
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
                            <Image Source="{Binding ImagenPerfil}" Height="300" Width="240" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="30 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0 0 0 18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0 0 10 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Nombre de usuario" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>

                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45">
                                    <TextBox Text="{Binding Nombre}" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" Margin="10 0 0 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Apellido de usuario" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>

                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45">
                                    <TextBox Text="{Binding Apellido}" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0 0 0 18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0 0 10 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Rol" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>

                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45">
                                    <Grid>
                                        <ComboBox SelectedValue="{Binding Rol, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Background="Transparent" BorderThickness="0" Padding="8 0 8 0">
                                            <ComboBoxItem Content="Administrador"/>
                                            <ComboBoxItem Content="Técnico"/>
                                            <ComboBoxItem Content="Usuario"/>
                                        </ComboBox>

                                        <TextBlock Text="Selecciona tu rol:" Foreground="Gray" Margin="12 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rol}" Value="Administrador">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rol}" Value="Técnico">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rol}" Value="Usuario">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" Margin="10 0 0 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Género" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>

                                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45">
                                    <Grid>
                                        <ComboBox SelectedValue="{Binding Genero, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Background="Transparent" BorderThickness="0" Padding="8 0 8 0">
                                            <ComboBoxItem Content="Hombre"/>
                                            <ComboBoxItem Content="Mujer"/>
                                        </ComboBox>

                                        <TextBlock Text="Género:" Foreground="Gray" Margin="12 0 0 0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Genero}" Value="Hombre">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Genero}" Value="Mujer">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0 0 0 18">
                            <TextBlock Text="Departamento" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>

                            <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45" Margin="0 28 0 0">
                                <ComboBox ItemsSource="{Binding DepartamentosComboBox}"
                                          SelectedItem="{Binding Departamento}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="14"
                                          Padding="8 0 8 0"
                                          Height="43"
                                          Margin="1"
                                          VerticalContentAlignment="Center"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          MaxDropDownHeight="120">

                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Departamento}" Value="Seleccione departamento">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>

                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8 5"/>
                                            <Style.Triggers>
                                                <Trigger Property="Content" Value="Seleccione departamento">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0 0 0 18">
                            <TextBlock Text="Número" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>
                            <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45" Margin="0 28 0 0">
                                <TextBox Text="{Binding Numero}" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0 0 0 18">
                            <TextBlock Text="Correo electrónico" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>
                            <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45" Margin="0 28 0 0">
                                <TextBox Text="{Binding Correo}" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0 0 0 18">
                            <TextBlock Text="Contraseña" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>
                            <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45" Margin="0 28 0 0">
                                <PasswordBox x:Name="txtContrasena" PasswordChanged="txtContrasena_PasswordChanged" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="6" Margin="0 0 0 30">
                            <TextBlock Text="Confirmar contraseña" FontSize="14" Foreground="#374151" Margin="0 0 0 8"/>
                            <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Height="45" Margin="0 28 0 0">
                                <PasswordBox x:Name="txtConfirmarContrasena" PasswordChanged="txtConfirmarContrasena_PasswordChanged" Background="Transparent" BorderThickness="0" Padding="12 10 12 0"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="7">
                            <Border Background="#E5E7EB" Height="45" Width="140" CornerRadius="10" HorizontalAlignment="Left">
                                <Button Content="Cancelar" Background="Transparent" BorderThickness="0" Foreground="#374151" Click="btnCancelar_Click"/>
                            </Border>

                            <Border Background="#2F6BFF" Height="45" Width="140" CornerRadius="10" HorizontalAlignment="Right">
                                <Button Content="Crear" Background="Transparent" BorderThickness="0" Foreground="White" Click="btnCrear_Click"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>