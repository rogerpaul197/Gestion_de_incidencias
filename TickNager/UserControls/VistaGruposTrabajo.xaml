<UserControl x:Class="TickNager.UserControls.VistaGruposTrabajo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Grupos de trabajo"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1D2B53"/>

                <TextBlock Text="Consulta los departamentos registrados y sus miembros"
                           Margin="0 8 0 0"
                           FontSize="18"
                           Foreground="#6B7280"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="175"
                    Height="52"
                    Background="#2F6BFF"
                    CornerRadius="10"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsAdmin}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Button Content="+  Nuevo grupo"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="btnNuevoGrupo_Click"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            CornerRadius="14 14 0 0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0 0 0 1">

                        <Grid Margin="18 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Departamento"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock Grid.Column="1"
                                       Text="Miembros"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock Grid.Column="2"
                                       Text="Acciones"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding GruposTrabajo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:GrupoTrabajoCreado/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
