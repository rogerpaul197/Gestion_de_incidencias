<UserControl x:Class="TickNager.UserControls.VistaPerfilUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="610" d:DesignWidth="800">
    
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Perfil de usuario"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1D2B53"/>

                <TextBlock Text="Información del usuario"
                           Margin="0 8 0 0"
                           FontSize="18"
                           Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <Image Source="{Binding ImagenPerfil}" Width="80" Height="80"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding NombreCompleto}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="{Binding RolUsuario}"
                               Margin="0 8 0 0"
                               FontSize="16"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                               Text="{Binding CorreoUsuario}"
                               Margin="0 15 0 0"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="4"
                               Text="{Binding Departamento}"
                               Margin="0 5 0 0"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <Border Grid.Row="5"
                            Background="#2F6BFF"
                            Height="45"
                            Width="140"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            Margin="0 30 0 0">

                        <Button Content="Volver"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Click="btnVolver_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
