<UserControl x:Class="TickNager.UserControls.CategoriaCreada"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="400" BorderBrush="Transparent" Background="Transparent">
    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Margin="10" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border Width="120" Height="120" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Imagenes/Iconos/interrogacion_por_defecto.png" Width="78" Height="78"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0 18 0 0">
                <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" TextAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0 12 0 0">
                <Border Background="#EEF2FF" CornerRadius="14" Padding="12 6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TextoCantidadIncidencias}" FontSize="13" FontWeight="SemiBold" Foreground="#4338CA" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
