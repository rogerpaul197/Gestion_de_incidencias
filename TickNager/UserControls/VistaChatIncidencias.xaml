<UserControl x:Class="TickNager.UserControls.VistaChatIncidencias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TickNager.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="35 30 35 20">
            <StackPanel>
                <TextBlock Text="Chat de incidencias"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#1D2B53"/>

                <TextBlock Text="Comunicación interna sobre las incidencias registradas"
                       Margin="0 8 0 0"
                       FontSize="18"
                       Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="35 0 35 30">
            <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LISTA INCIDENCIAS -->
                    <Border Grid.Column="0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0 1 1 0"
                        CornerRadius="14 0 0 14">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0 0 0 1"
                                Padding="18 0">

                                <TextBlock Text="Incidencias"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            </Border>

                            <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Incidencias}"
                                 SelectedItem="{Binding IncidenciaSeleccionada}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                        <Setter Property="Padding"
                                            Value="0"/>
                                        <Setter Property="Margin"
                                            Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16 12"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0 0 0 1">

                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Estado}"
                                                       Margin="0 4 0 0"
                                                       FontSize="12"
                                                       Foreground="#6B7280"/>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- CHAT -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>

                        <!-- CABECERA -->
                        <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0 0 0 1"
                            Padding="20 0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding IncidenciaSeleccionada.Titulo}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>

                        <!-- MENSAJES -->
                        <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24">

                            <ItemsControl ItemsSource="{Binding Comentarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0 0 0 12"
                                            MaxWidth="520">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment"
                                                        Value="Left"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsUsuarioActual}"
                                                                 Value="True">
                                                            <Setter Property="HorizontalAlignment"
                                                                Value="Right"/>
                                                            <Setter Property="Background"
                                                                Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <Grid Margin="0 0 0 8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                           Text="{Binding Usuario}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           Margin="0 0 25 0"/>

                                                    <TextBlock Grid.Column="1"
                                                           Text="{Binding Fecha}"
                                                           FontSize="12"
                                                           Foreground="#6B7280"
                                                           VerticalAlignment="Center"/>

                                                </Grid>

                                                <TextBlock Text="{Binding Mensaje}"
                                                       FontSize="15"
                                                       Foreground="#374151"
                                                       TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ENVIAR -->
                        <Border Grid.Row="2"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0 1 0 0"
                            Padding="18 14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="50"
                                    Margin="0 0 14 0">

                                    <TextBox Text="{Binding NuevoComentario}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="15"
                                         Padding="14 12 14 0"/>

                                </Border>
                                
                                <Border Grid.Column="1"
                                    Background="#2F6BFF"
                                    CornerRadius="10"
                                    Height="50">

                                    <Button Content="Enviar"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="btnEnviar_Click"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
